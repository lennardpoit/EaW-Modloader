<Window x:Class="EaWModLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EaWModLauncher"
        Title="{Binding [WindowTitle], Source={x:Static local:Loc.Instance}}"
        Width="1140" Height="760" MinWidth="1000" MinHeight="460"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Bahnschrift, Segoe UI" FontSize="13"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Activated="Window_Activated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Mod-Kachel -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Margin" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Width="228" Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="22"
                                                          ShadowDepth="0" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card" To="1.03" Duration="0:0:0.12"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation Storyboard.TargetName="Card" To="1.03" Duration="0:0:0.12"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card" To="1" Duration="0:0:0.12"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation Storyboard.TargetName="Card" To="1" Duration="0:0:0.12"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nur sichtbar, solange die Maus über der Kachel ist -->
        <Style x:Key="ShowOnTileHover" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Abschnittsüberschrift -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <!-- Sprachumschalter mit Flagge; die aktive Sprache hat Tag="active" -->
        <Style x:Key="FlagButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="3" Padding="3"
                                Background="Transparent">
                            <Border BorderBrush="#55FFFFFF" BorderThickness="1">
                                <ContentPresenter/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="Tag" Value="active">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Kachel-Vorlage für "Meine Mods" und "Beliebte Mods" -->
        <DataTemplate x:Key="ModTile">
            <Button Style="{StaticResource TileButton}" Click="Tile_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding [MenuStart], Source={x:Static local:Loc.Instance}}"
                                  FontWeight="SemiBold" Click="MenuStart_Click"/>
                        <MenuItem Header="{Binding [MenuAdopt], Source={x:Static local:Loc.Instance}}" Click="MenuAdopt_Click"
                                  Visibility="{Binding IsSuggestion, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="{Binding [MenuRefresh], Source={x:Static local:Loc.Instance}}" Click="MenuRefresh_Click"/>
                        <MenuItem Header="{Binding [MenuWorkshop], Source={x:Static local:Loc.Instance}}" Click="MenuWorkshop_Click"/>
                        <MenuItem Header="{Binding [MenuCopy], Source={x:Static local:Loc.Instance}}" Click="MenuCopy_Click"/>
                        <Separator Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="{Binding [MenuMoveUp], Source={x:Static local:Loc.Instance}}" Click="MenuMoveUp_Click"
                                  Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="{Binding [MenuMoveDown], Source={x:Static local:Loc.Instance}}" Click="MenuMoveDown_Click"
                                  Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}"/>
                        <Separator/>
                        <MenuItem Header="{Binding [MenuRemove], Source={x:Static local:Loc.Instance}}" Click="MenuRemove_Click"
                                  Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="{Binding [MenuHide], Source={x:Static local:Loc.Instance}}" Click="MenuHide_Click"
                                  Visibility="{Binding IsSuggestion, Converter={StaticResource BoolToVis}}"/>
                    </ContextMenu>
                </Button.ContextMenu>

                <StackPanel>
                    <Grid Height="226">
                        <!-- Platzhalter ohne Bild -->
                        <Border CornerRadius="3,3,0,0" Background="#0B0C10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="{DynamicResource EmblemImage}" Width="72" Opacity="0.18"/>
                                <TextBlock Text="{Binding [NoPreview], Source={x:Static local:Loc.Instance}}"
                                           Foreground="{StaticResource Muted}"
                                           Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border CornerRadius="3,3,0,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <!-- Hinweis, wenn die Mod nicht abonniert ist -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="7,3"
                                CornerRadius="2" Background="#D9000000" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding [NotSubscribed], Source={x:Static local:Loc.Instance}}"
                                       Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <!-- Aktion beim Überfahren -->
                        <Border VerticalAlignment="Bottom" Height="54" Style="{StaticResource ShowOnTileHover}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#E6000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding HoverText}" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                        </Border>
                    </Grid>
                    <Border Height="2" Background="{StaticResource Accent}" Style="{StaticResource ShowOnTileHover}"/>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Fg}" FontWeight="SemiBold"
                               FontSize="14" Margin="12,9,12,2" Height="38" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Id, StringFormat=WORKSHOP-ID {0}}"
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,12,11"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Kopfleiste mit Logo -->
        <Border DockPanel.Dock="Top" Background="Black" Padding="22,10,22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo wird zur Laufzeit aus der Spielinstallation geladen; sonst Text als Ersatz -->
                <Grid Width="184" Height="58" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel x:Name="LogoFallback" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="EMPIRE AT WAR" Foreground="{StaticResource Accent}" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="FORCES OF CORRUPTION" Foreground="{StaticResource Fg}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Column="1" Width="1" Margin="18,4" Background="{StaticResource Line}"/>
                <TextBlock Grid.Column="2" Text="{Binding [HeaderSubtitle], Source={x:Static local:Loc.Instance}}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" FontSize="15" FontWeight="SemiBold"/>

                <Grid Grid.Column="3" MinWidth="170" MaxWidth="380" Margin="24,0,0,0" HorizontalAlignment="Stretch">
                    <TextBox x:Name="ModInput" Style="{StaticResource DarkTextBox}"
                             KeyDown="ModInput_KeyDown" TextChanged="ModInput_TextChanged"/>
                    <TextBlock x:Name="InputHint" IsHitTestVisible="False" Margin="11,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                               Text="{Binding [InputHint], Source={x:Static local:Loc.Instance}}"/>
                </Grid>

                <Button x:Name="AddButton" Grid.Column="4" Margin="8,0,0,0"
                        Content="{Binding [AddButton], Source={x:Static local:Loc.Instance}}"
                        Style="{StaticResource FlatButton}" Click="AddButton_Click"/>
                <Button Grid.Column="5" Margin="8,0,0,0"
                        Content="{Binding [PlayVanilla], Source={x:Static local:Loc.Instance}}"
                        ToolTip="{Binding [PlayVanillaTip], Source={x:Static local:Loc.Instance}}"
                        Style="{StaticResource GhostButton}" Click="Vanilla_Click"/>

                <!-- Sprache: Englisch / Deutsch -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="FlagEn" Style="{StaticResource FlagButton}" Click="LangEn_Click" ToolTip="English">
                        <Viewbox Height="16">
                            <!-- Union Jack (60 × 30) -->
                            <Canvas Width="60" Height="30" ClipToBounds="True">
                                <Rectangle Width="60" Height="30" Fill="#012169"/>
                                <Path Data="M0,0 L60,30 M60,0 L0,30" Stroke="White" StrokeThickness="6"/>
                                <Path Data="M0,0 L60,30 M60,0 L0,30" Stroke="#C8102E" StrokeThickness="4"
                                      Clip="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/>
                                <Path Data="M30,0 V30 M0,15 H60" Stroke="White" StrokeThickness="10"/>
                                <Path Data="M30,0 V30 M0,15 H60" Stroke="#C8102E" StrokeThickness="6"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="FlagDe" Style="{StaticResource FlagButton}" Click="LangDe_Click" ToolTip="Deutsch"
                            Margin="4,0,0,0">
                        <Viewbox Height="16">
                            <!-- Deutschland (5 : 3) -->
                            <Canvas Width="50" Height="30">
                                <Rectangle Width="50" Height="10" Fill="#000000"/>
                                <Rectangle Canvas.Top="10" Width="50" Height="10" Fill="#DD0000"/>
                                <Rectangle Canvas.Top="20" Width="50" Height="10" Fill="#FFCE00"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rote Trennlinie wie im Logo -->
        <Border DockPanel.Dock="Top" Height="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00E61821" Offset="0"/>
                    <GradientStop Color="{StaticResource AccentColor}" Offset="0.25"/>
                    <GradientStop Color="{StaticResource AccentColor}" Offset="0.75"/>
                    <GradientStop Color="#00E61821" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Hinweis auf neue Version -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="#1F0A0D"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" Foreground="{StaticResource Fg}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="UpdateButton" Grid.Column="1" Padding="12,5"
                        Content="{Binding [UpdateNow], Source={x:Static local:Loc.Instance}}"
                        Style="{StaticResource FlatButton}" Click="UpdateNow_Click"/>
                <Button Grid.Column="2" Padding="12,5" Margin="8,0,0,0"
                        Content="{Binding [WhatsNew], Source={x:Static local:Loc.Instance}}"
                        Style="{StaticResource GhostButton}" Click="UpdateDetails_Click"/>
                <Button x:Name="UpdateDismissButton" Grid.Column="3" Content="✕" Padding="10,5" Margin="8,0,0,0"
                        ToolTip="{Binding [RemindLater], Source={x:Static local:Loc.Instance}}"
                        Style="{StaticResource GhostButton}" Click="UpdateDismiss_Click"/>
            </Grid>
        </Border>

        <!-- Statuszeile -->
        <Border DockPanel.Dock="Bottom" Background="Black" Padding="22,7"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,0,250,0"/>
                <TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" FontSize="12"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Kacheln auf Sternenhimmel -->
        <Grid x:Name="ContentArea">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,8,14,14">
                <StackPanel>
                    <!-- Meine Mods -->
                    <TextBlock Text="{Binding [MyMods], Source={x:Static local:Loc.Instance}}"
                               Style="{StaticResource SectionTitle}" Margin="11,12,11,0"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="11,4,11,0"
                               Text="{Binding [MyModsInfo], Source={x:Static local:Loc.Instance}}"/>
                    <TextBlock x:Name="OwnEmptyHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="11,10,11,10"
                               Text="{Binding [MyModsEmpty], Source={x:Static local:Loc.Instance}}"/>
                    <ItemsControl x:Name="ModList" ItemsPanel="{StaticResource TilePanel}"
                                  ItemTemplate="{StaticResource ModTile}"/>

                    <!-- Beliebte Mods -->
                    <Border x:Name="SuggestionHeader" Margin="11,22,11,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding [PopularMods], Source={x:Static local:Loc.Instance}}"
                                           Style="{StaticResource SectionTitle}"/>
                                <TextBlock Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="{Binding [PopularInfo], Source={x:Static local:Loc.Instance}}"/>
                            </StackPanel>
                            <Button x:Name="ShowHiddenButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                    Click="ShowHidden_Click" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="SuggestionList" Margin="0,4,0,0" ItemsPanel="{StaticResource TilePanel}"
                                  ItemTemplate="{StaticResource ModTile}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
