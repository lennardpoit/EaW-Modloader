<Window x:Class="EaWModLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forces of Corruption – Mod-Launcher" Width="1120" Height="760" MinWidth="880" MinHeight="460"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Bahnschrift, Segoe UI" FontSize="13"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Activated="Window_Activated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Mod-Kachel -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Margin" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Width="228" Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="22"
                                                          ShadowDepth="0" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card" To="1.03" Duration="0:0:0.12"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation Storyboard.TargetName="Card" To="1.03" Duration="0:0:0.12"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card" To="1" Duration="0:0:0.12"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation Storyboard.TargetName="Card" To="1" Duration="0:0:0.12"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nur sichtbar, solange die Maus über der Kachel ist -->
        <Style x:Key="ShowOnTileHover" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Abschnittsüberschrift -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <!-- Kachel-Vorlage für "Meine Mods" und "Beliebte Mods" -->
        <DataTemplate x:Key="ModTile">
            <Button Style="{StaticResource TileButton}" Click="Tile_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Starten" FontWeight="SemiBold" Click="MenuStart_Click"/>
                        <MenuItem Header="Zu „Meine Mods“ hinzufügen" Click="MenuAdopt_Click"
                                  Visibility="{Binding IsSuggestion, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Name und Bild aktualisieren" Click="MenuRefresh_Click"/>
                        <MenuItem Header="Workshop-Seite öffnen" Click="MenuWorkshop_Click"/>
                        <MenuItem Header="Startoption kopieren" Click="MenuCopy_Click"/>
                        <Separator Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Nach vorne verschieben" Click="MenuMoveUp_Click"
                                  Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Nach hinten verschieben" Click="MenuMoveDown_Click"
                                  Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}"/>
                        <Separator/>
                        <MenuItem Header="Entfernen" Click="MenuRemove_Click"
                                  Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Vorschlag ausblenden" Click="MenuHide_Click"
                                  Visibility="{Binding IsSuggestion, Converter={StaticResource BoolToVis}}"/>
                    </ContextMenu>
                </Button.ContextMenu>

                <StackPanel>
                    <Grid Height="226">
                        <!-- Platzhalter ohne Bild -->
                        <Border CornerRadius="3,3,0,0" Background="#0B0C10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="{DynamicResource EmblemImage}" Width="72" Opacity="0.18"/>
                                <TextBlock Text="Kein Vorschaubild" Foreground="{StaticResource Muted}"
                                           Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border CornerRadius="3,3,0,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <!-- Hinweis, wenn die Mod nicht abonniert ist -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="7,3"
                                CornerRadius="2" Background="#D9000000" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="NICHT ABONNIERT" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <!-- Aktion beim Überfahren -->
                        <Border VerticalAlignment="Bottom" Height="54" Style="{StaticResource ShowOnTileHover}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#E6000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding HoverText}" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                        </Border>
                    </Grid>
                    <Border Height="2" Background="{StaticResource Accent}" Style="{StaticResource ShowOnTileHover}"/>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Fg}" FontWeight="SemiBold"
                               FontSize="14" Margin="12,9,12,2" Height="38" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Id, StringFormat=WORKSHOP-ID {0}}"
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,12,11"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Kopfleiste mit Logo -->
        <Border DockPanel.Dock="Top" Background="Black" Padding="22,10,22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo wird zur Laufzeit aus der Spielinstallation geladen; sonst Text als Ersatz -->
                <Grid Width="184" Height="58" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel x:Name="LogoFallback" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="EMPIRE AT WAR" Foreground="{StaticResource Accent}" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="FORCES OF CORRUPTION" Foreground="{StaticResource Fg}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Column="1" Width="1" Margin="18,4" Background="{StaticResource Line}"/>
                <TextBlock Grid.Column="2" Text="MOD-LAUNCHER" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" FontSize="15" FontWeight="SemiBold"/>

                <Grid Grid.Column="3" MinWidth="170" MaxWidth="380" Margin="24,0,0,0" HorizontalAlignment="Stretch">
                    <TextBox x:Name="ModInput" Style="{StaticResource DarkTextBox}"
                             KeyDown="ModInput_KeyDown" TextChanged="ModInput_TextChanged"/>
                    <TextBlock x:Name="InputHint" IsHitTestVisible="False" Margin="11,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                               Text="Workshop-ID oder Link einfügen …"/>
                </Grid>

                <Button x:Name="AddButton" Grid.Column="4" Margin="8,0,0,0" Content="+ HINZUFÜGEN"
                        Style="{StaticResource FlatButton}" Click="AddButton_Click"/>
                <Button Grid.Column="5" Margin="8,0,0,0" Content="OHNE MOD STARTEN"
                        Style="{StaticResource GhostButton}" Click="Vanilla_Click"
                        ToolTip="Forces of Corruption ohne Mod starten"/>
            </Grid>
        </Border>

        <!-- Rote Trennlinie wie im Logo -->
        <Border DockPanel.Dock="Top" Height="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00E61821" Offset="0"/>
                    <GradientStop Color="{StaticResource AccentColor}" Offset="0.25"/>
                    <GradientStop Color="{StaticResource AccentColor}" Offset="0.75"/>
                    <GradientStop Color="#00E61821" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Statuszeile -->
        <Border DockPanel.Dock="Bottom" Background="Black" Padding="22,7"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,0,90,0"
                           Text="Bereit. Klick auf eine Kachel startet die Mod, Rechtsklick für weitere Optionen."/>
                <TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" FontSize="12"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Kacheln auf Sternenhimmel -->
        <Grid x:Name="ContentArea">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,8,14,14">
                <StackPanel>
                    <!-- Meine Mods -->
                    <TextBlock Text="MEINE MODS" Style="{StaticResource SectionTitle}" Margin="11,12,11,0"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="11,4,11,0"
                               Text="Alle Mods, die du im Steam Workshop abonniert hast, erscheinen hier automatisch."/>
                    <TextBlock x:Name="OwnEmptyHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="11,10,11,10"
                               Text="Noch keine Mods abonniert. Abonniere unten eine der beliebten Mods oder füge oben eine Workshop-ID bzw. einen Link ein."/>
                    <ItemsControl x:Name="ModList" ItemsPanel="{StaticResource TilePanel}"
                                  ItemTemplate="{StaticResource ModTile}"/>

                    <!-- Beliebte Mods -->
                    <Border x:Name="SuggestionHeader" Margin="11,22,11,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="BELIEBTE MODS" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Die meistabonnierten Mods im Steam Workshop, die du noch nicht hast. Ein Klick öffnet die Workshop-Seite zum Abonnieren – danach erscheint die Mod automatisch unter „Meine Mods“."/>
                            </StackPanel>
                            <Button x:Name="ShowHiddenButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                    Click="ShowHidden_Click" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="SuggestionList" Margin="0,4,0,0" ItemsPanel="{StaticResource TilePanel}"
                                  ItemTemplate="{StaticResource ModTile}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
